# AgriTrace Environment Configuration Example
PROJECT_NAME="AgriTrace"
ENVIRONMENT="development"

# Database Configuration
POSTGRES_SERVER=db
POSTGRES_USER=agritrace
POSTGRES_PASSWORD=agritrace_secret_pass
POSTGRES_DB=agritrace_db
POSTGRES_PORT=5432

# SQLAlchemy Database URL (Neon PostgreSQL example)
DATABASE_URL=postgresql://user:password@ep-rest-of-id.region.aws.neon.tech/neondb?sslmode=require

# Security & JWT Token
SECRET_KEY=super_secret_jwt_key_change_in_production_32bytes_min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (Comma separated)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
